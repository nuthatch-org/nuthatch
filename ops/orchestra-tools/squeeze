#!/usr/bin/env python3
"""squeeze - compress noisy command output for LLM consumption.

  some-cmd 2>&1 | squeeze
  squeeze -- <cmd...>      # runs cmd, merges stderr, preserves exit code

Env: SQUEEZE_MAX (default 150) soft cap on content lines. Error lines are
never dropped, even if that exceeds the cap.
"""
import os
import re
import subprocess
import sys

HEAD, TAIL, CTX = 20, 40, 3

ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[()][A-Z0-9]")
SPINNER = re.compile(r"[⠀-⣿⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]")
BAR = re.compile(r"(\[[#=>\-\. ]{8,}\]|[#=]{10,}|[█▓▒░■□▏▎▍▌▋▊▉]{4,}|\b\d{1,3}%\s*\|)")
IMPORTANT = re.compile(
    r"\b(errors?|warn(ing)?s?|panic(ked)?|fail(ed|ure|ures|s)?|denied|fatal|exception|traceback)\b|\b(403|404)\b"
    r"|error\[|ERR!|\bE\d{4}\b",
    re.I,
)
SECRETS = [
    (re.compile(r"github_pat_[A-Za-z0-9_]{10,}"), "[REDACTED:github_pat]"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{10,}"), "[REDACTED:gh_token]"),
    (re.compile(r"\bsk-[A-Za-z0-9_\-]{12,}"), "[REDACTED:sk]"),
    (re.compile(r"\bgqk[_\-][A-Za-z0-9_\-]{6,}", re.I), "[REDACTED:gqk]"),
    (re.compile(r"(?i)\b(bearer)\s+[A-Za-z0-9._~+/=\-]{8,}"), r"\1 [REDACTED]"),
    (re.compile(r"(?i)\b(authorization|x-api-key)\s*[:=]\s*(?!\[REDACTED)\S+(\s+\S+)?"), r"\1: [REDACTED]"),
]
NUM = re.compile(r"\d+(?:\.\d+)*|\b[0-9a-f]{7,}\b")


def redact(s):
    for rx, rep in SECRETS:
        s = rx.sub(rep, s)
    return s


def clean(raw):
    """Raw text -> list of cleaned lines (ANSI/progress/spinners removed, secrets redacted)."""
    out = []
    for line in raw.split("\n"):
        if "\r" in line:  # progress redraws: keep the final state only
            parts = [p for p in line.split("\r") if p.strip()]
            line = parts[-1] if parts else ""
        line = ANSI.sub("", line)
        line = redact(line).rstrip()
        if SPINNER.search(line) and len(line.strip()) < 80 and not IMPORTANT.search(line):
            continue
        if BAR.search(line) and not IMPORTANT.search(line):
            continue
        out.append(line)
    # collapse blank runs
    res = []
    for l in out:
        if not l and (not res or not res[-1]):
            continue
        res.append(l)
    while res and not res[-1]:
        res.pop()
    return res


def key(line):
    return NUM.sub("N", line.strip())


def collapse(lines):
    """Collapse runs (>=3) of near-identical non-important lines. -> [(text, important)]"""
    items, i = [], 0
    while i < len(lines):
        l = lines[i]
        imp = bool(IMPORTANT.search(l))
        if imp or not l.strip():
            items.append((l, imp))
            i += 1
            continue
        k, j = key(l), i + 1
        while j < len(lines) and not IMPORTANT.search(lines[j]) and key(lines[j]) == k:
            j += 1
        n = j - i
        if n >= 3:
            items.append((f"{l}  [x{n}, last: {lines[j-1].strip()[:60]}]" if lines[j-1] != l else f"{l}  [x{n}]", False))
        else:
            items.extend((lines[m], False) for m in range(i, j))
        i = j
    return items


def select(items, cap):
    n = len(items)
    keep = [False] * n
    imp = [i for i, (_, f) in enumerate(items) if f]
    for i in imp:
        keep[i] = True
    count = len(imp)
    tiers = [
        range(max(0, n - TAIL), n),
        range(0, min(HEAD, n)),
        [j for i in imp for j in range(max(0, i - CTX), min(n, i + CTX + 1))],
    ]
    # context is closer to errors than head/tail are; honour it first
    for tier in (tiers[2], tiers[0], tiers[1]):
        for i in tier:
            if not keep[i] and count < cap:
                keep[i] = True
                count += 1
    out, skipped = [], 0
    for i, (t, _) in enumerate(items):
        if keep[i]:
            if skipped:
                out.append(f"... [{skipped} lines omitted]")
                skipped = 0
            out.append(t)
        else:
            skipped += 1
    if skipped:
        out.append(f"... [{skipped} lines omitted]")
    return out


def squeeze(raw, cap):
    lines = clean(raw)
    return len(raw.splitlines()), select(collapse(lines), cap)


def main(argv):
    cap = int(os.environ.get("SQUEEZE_MAX", "150"))
    code = None
    if argv and argv[0] == "--":
        argv = argv[1:]
        if not argv:
            print("usage: squeeze [-- cmd...]", file=sys.stderr)
            return 2
        try:
            p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            raw, code = p.stdout.decode("utf-8", "replace"), p.returncode
            if code < 0:
                code = 128 - code
        except FileNotFoundError:
            raw, code = f"squeeze: command not found: {argv[0]}\n", 127
        except PermissionError:
            raw, code = f"squeeze: permission denied: {argv[0]}\n", 126
    elif argv and argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    else:
        raw = sys.stdin.buffer.read().decode("utf-8", "replace")
    n_in, out = squeeze(raw, cap)
    sys.stdout.write("\n".join(out) + ("\n" if out else ""))
    print(f"[squeeze] lines in={n_in} out={len(out)} exit={'-' if code is None else code}")
    return code or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
