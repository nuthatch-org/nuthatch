# /etc/systemd/system/nuthatch-public-base-usdc-proxy.service
# nginx-base-usdc.conf as its own unprivileged instance, on 127.0.0.1:8481 (docs/public-nests.md).
# It does not use, replace or reload the system nginx, and does not bind 80 or 443: Caddy keeps those.
[Unit]
Description=nuthatch public nests: Base USDC rate limits and route allowlist
Documentation=https://github.com/nuthatch-org/nuthatch/blob/main/docs/public-nests.md
After=network.target nuthatch-public-base-usdc.service

[Service]
Type=simple
User=nests-public
Group=nests-public
# /run/nuthatch-public-base-usdc is made, owned by the service user, and removed on stop.
RuntimeDirectory=nuthatch-public-base-usdc
ExecStartPre=/usr/bin/mkdir -p /run/nuthatch-public-base-usdc/tmp
ExecStartPre=/usr/sbin/nginx -t -c /etc/nuthatch-public/nginx-base-usdc.conf -e stderr
ExecStart=/usr/sbin/nginx -c /etc/nuthatch-public/nginx-base-usdc.conf -e stderr
ExecReload=/usr/sbin/nginx -t -c /etc/nuthatch-public/nginx-base-usdc.conf -e stderr
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
MemoryMax=256M

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
