# Append to Helsinki's /etc/caddy/Caddyfile (docs/public-nests.md step 7), with the real name in place
# of base.example.org. Caddy does what it is already doing on that box: DNS name, TLS certificate,
# renewal. Everything else is decided one hop in, by nginx-base-usdc.conf on 127.0.0.1:8481.
#
# Caddy sets X-Forwarded-For to the address it saw and ignores one a client sent (stock behaviour, no
# trusted_proxies configured), and nginx.conf reads that to rate-limit each caller separately. Do not
# add trusted_proxies here: that would let a caller choose the address they are limited under.
base.example.org {
	request_body {
		max_size 64KB
	}
	reverse_proxy 127.0.0.1:8481 {
		transport http {
			dial_timeout 2s
			response_header_timeout 20s
		}
	}
}
