# /etc/nuthatch-public/arc-testnet.env   (root:nests-public, mode 0640; docs/public-nests.md step 4)
#
# Everything the unit takes from the host. No secret is committed: the two RPC URLs below are Arc's
# own keyless public endpoints, from https://docs.arc.io/arc/references/rpc-endpoints. If you put a
# keyed URL in either (a provider key, GraphOps', anyone's), it lives in this file and nowhere else.

# The public name Caddy serves this on. The nest runs bound to loopback and answers a Host it was
# told about (--public-host), so this has to be the name callers type, with no scheme and no port.
PUBLIC_HOST=arc.example.org

# Two endpoints, so one 429 or one outage does not stall the cursor. Arc's docs list Circle's primary
# and QuickNode, Blockdaemon and dRPC for testnet; this nest's README records why Blockdaemon and
# dRPC's free tier are left out (a gzip body it cannot read; a range cap).
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_RPC_URL_2=https://rpc.quicknode.testnet.arc.io

# Ceilings for what one query may cost. Each can only lower nuthatch's own limits (30 s, 50,000 rows,
# 64 MiB), never raise them. See docs/operators.md "Query guards".
NUTHATCH_SQL_TIMEOUT_MS=10000
NUTHATCH_SQL_MAX_ROWS=5000
NUTHATCH_SQL_MAX_RESULT_BYTES=8388608

# What /mcp offers, as the proxy's own allowlist: every tool calls its route in process, past nginx, so a
# tool is listed only if nginx.conf serves that route (#3138). test-proxy.sh checks this list against it.
NUTHATCH_MCP_TOOLS=status,schema,tables,table,sql,explain

# No head count, whatever anyone answers at a terminal on this host (docs/operators.md, RFC-0054).
NUTHATCH_NO_COUNT=1
