# /etc/nuthatch-public/base-usdc.env   (root:nests-public, mode 0640; docs/public-nests.md, "The second nest")
#
# Everything the unit takes from the host. This file is the only place the GraphOps key lives; the value
# below is a placeholder and no real one is committed anywhere.

# The public name Caddy serves this on: no scheme, no port.
PUBLIC_HOST=base.example.org

# GraphOps RPC for Base (chain id 8453): https://rpc.graphops.xyz/v1/evm/<chain id>/<api key>. Use a key
# made for this nest and limited to RPC (`graphops api-keys create`), so it can be revoked on its own.
# nuthatch reads NUTHATCH_RPC as `--rpc`, which replaces the keyless rpc_urls in nuthatch.toml at runtime.
NUTHATCH_RPC=https://rpc.graphops.xyz/v1/evm/8453/REPLACE_WITH_API_KEY

# Ceilings for what one query may cost, as the Arc nest.
NUTHATCH_SQL_TIMEOUT_MS=10000
NUTHATCH_SQL_MAX_ROWS=5000
NUTHATCH_SQL_MAX_RESULT_BYTES=8388608

# No head count, whatever anyone answers at a terminal on this host (docs/operators.md, RFC-0054).
NUTHATCH_NO_COUNT=1
