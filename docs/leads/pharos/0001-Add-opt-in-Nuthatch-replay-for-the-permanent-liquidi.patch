--- /dev/null
+++ b/scripts/maintenance/__tests__/permanent-liquidity-nuthatch.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from "vitest";
+import {
+  balancesFromRows,
+  balancesSql,
+  checkReplay,
+  firstWord,
+  parseLpNestArgs,
+  parseTokenSpec,
+  renderNestToml,
+} from "../permanent-liquidity-nuthatch.mjs";
+
+const LUSD3CRV = "0xEd279fDD11cA84bEef15AF5D39BB4d4bEE23F0cA";
+const ZERO = "0x0000000000000000000000000000000000000000";
+
+describe("permanent-liquidity Nuthatch replay", () => {
+  it("parses LP specs with an optional start block and rejects anything else", () => {
+    expect(parseTokenSpec(`${LUSD3CRV}:12184843`)).toEqual({ address: LUSD3CRV.toLowerCase(), startBlock: 12184843 });
+    expect(parseTokenSpec(LUSD3CRV).startBlock).toBe(0);
+    expect(() => parseTokenSpec("0x123")).toThrow(/LP token must be/);
+    expect(() => parseTokenSpec(`${LUSD3CRV}:1:2`)).toThrow(/LP token must be/);
+  });
+
+  it("requires --rpc, --dir and a token, and rejects unknown options", () => {
+    expect(() => parseLpNestArgs([LUSD3CRV])).toThrow(/--rpc/);
+    expect(() => parseLpNestArgs(["--rpc", "http://x", LUSD3CRV])).toThrow(/--dir/);
+    expect(() => parseLpNestArgs(["--rpc", "http://x", "--dir", "d"])).toThrow(/at least one LP token/);
+    expect(() => parseLpNestArgs(["--rpc", "http://x", "--dir", "d", "--bogus", LUSD3CRV])).toThrow();
+  });
+
+  it("renders one contract entry per LP token", () => {
+    const options = parseLpNestArgs(["--rpc", "http://x", "--dir", "d", `${LUSD3CRV}:12184843`, "0x3041CbD36888bECc7bbCBc0045E3B1f144466f5f"]);
+    const toml = renderNestToml(options);
+    expect(toml.match(/\[\[contracts\]\]/g)).toHaveLength(2);
+    expect(toml).toContain('alias = "lp1"');
+    expect(toml).toContain("start_block = 12184843");
+    expect(toml).toContain("block_timestamps = false");
+  });
+
+  it("builds the replay query over the alias table", () => {
+    expect(balancesSql("lp0__transfer")).toContain("FROM lp0__transfer");
+  });
+
+  it("passes when non-zero holders plus balanceOf(0x0) equal totalSupply", () => {
+    // A Uniswap V2 style pair: 1000 LP minted to 0x0 stays there, the rest is held by two holders.
+    const balances = balancesFromRows([
+      { addr: ZERO, bal: "-1000000" },
+      { addr: "0xAA", bal: "600000" },
+      { addr: "0xBB", bal: "399000" },
+    ]);
+    expect(checkReplay(balances, { totalSupply: 1_000_000n, balanceOfZero: 1000n })).toEqual({ replaySupply: 999_000n, ok: true });
+    expect(checkReplay(balances, { totalSupply: 1_000_000n, balanceOfZero: 0n }).ok).toBe(false);
+  });
+
+  it("reads the first word of a padded eth_call result", () => {
+    const word = `0x${"0".repeat(63)}a`;
+    expect(firstWord(`${word}${"0".repeat(128)}`)).toBe(10n);
+  });
+});
