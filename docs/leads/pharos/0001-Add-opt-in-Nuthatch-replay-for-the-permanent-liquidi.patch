@@ -0,0 +1,193 @@
+#!/usr/bin/env node
+
+// Opt-in alternative to the fungible-LP Transfer replay in issue #2048: let a local Nuthatch nest
+// (https://github.com/nuthatch-org/nuthatch) fetch and seal every Transfer of the given LP tokens,
+// then rebuild balances from it and run `replay + balanceOf(0x0) == totalSupply`.
+// Read-only: no Worker, D1, registry or scoring path is touched. Docs: docs/permanent-liquidity-nuthatch.md
+
+import { spawn } from "node:child_process";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { setTimeout as sleep } from "node:timers/promises";
+import { CliUsageError, parseCliInteger, parseStrictCliArgs, runDirectCli } from "../lib/cli-args.mjs";
+
+const ADDRESS_PATTERN = /^0x[0-9a-fA-F]{40}$/;
+const ZERO_ADDRESS = "0x0000000000000000000000000000000000000000";
+const TOTAL_SUPPLY_SELECTOR = "0x18160ddd";
+const BALANCE_OF_SELECTOR = "0x70a08231";
+
+const TRANSFER_ABI = [
+  {
+    type: "event",
+    name: "Transfer",
+    anonymous: false,
+    inputs: [
+      { name: "from", type: "address", indexed: true },
+      { name: "to", type: "address", indexed: true },
+      { name: "value", type: "uint256", indexed: false },
+    ],
+  },
+];
+
+/** `0xLP` or `0xLP:startBlock`. The start block is the first block that may hold a Transfer; default 0. */
+export function parseTokenSpec(spec) {
+  const [address, start = "0", ...rest] = String(spec).split(":");
+  if (rest.length > 0 || !ADDRESS_PATTERN.test(address) || !/^\d+$/.test(start)) {
+    throw new CliUsageError(`LP token must be 0xAddress or 0xAddress:startBlock, got ${spec}`);
+  }
+  return { address: address.toLowerCase(), startBlock: Number(start) };
+}
+
+export function parseLpNestArgs(argv) {
+  const { values, positionals } = parseStrictCliArgs(argv, {
+    allowPositionals: true,
+    options: {
+      rpc: { type: "string" },
+      dir: { type: "string" },
+      "chain-id": { type: "string", default: "1" },
+      chain: { type: "string", default: "mainnet" },
+      window: { type: "string", default: "5000" },
+      concurrency: { type: "string", default: "4" },
+      nuthatch: { type: "string", default: "nuthatch" },
+      port: { type: "string", default: "8288" },
+      "min-pct": { type: "string", default: "0.1" },
+      attach: { type: "boolean" },
+    },
+  });
+  if (!values.rpc) throw new CliUsageError("--rpc <archive eth_getLogs URL> is required");
+  if (!values.dir) throw new CliUsageError("--dir <nest directory> is required");
+  if (positionals.length === 0) throw new CliUsageError("Pass at least one LP token: 0xAddress[:startBlock]");
+  return {
+    rpc: values.rpc,
+    dir: values.dir,
+    chainId: parseCliInteger(values["chain-id"], { name: "--chain-id", min: 1 }),
+    chain: values.chain,
+    window: parseCliInteger(values.window, { name: "--window", min: 1 }),
+    concurrency: parseCliInteger(values.concurrency, { name: "--concurrency", min: 1, max: 32 }),
+    nuthatch: values.nuthatch,
+    port: parseCliInteger(values.port, { name: "--port", min: 1, max: 65535 }),
+    minPct: Number(values["min-pct"]),
+    attach: Boolean(values.attach),
+    tokens: positionals.map(parseTokenSpec).map((token, index) => ({ ...token, alias: `lp${index}` })),
+  };
+}
+
+/** One [[contracts]] entry per LP token over a shared ERC-20 Transfer ABI. Timestamps are not needed. */
+export function renderNestToml({ chain, chainId, rpc, tokens }) {
+  const header = `[nest]\nname = "pharos-lp-scan"\nchain = "${chain}"\nchain_id = ${chainId}\nrpc_urls = ["${rpc}"]\nschema_version = 2\nblock_timestamps = false\n`;
+  const contracts = tokens.map(
+    ({ alias, address, startBlock }) =>
+      `\n[[contracts]]\nalias = "${alias}"\naddress = "${address}"\nstart_block = ${startBlock}\nabi = "abis/erc20_transfer.json"\n`,
+  );
+  return header + contracts.join("");
+}
+
+/** The replay, in SQL over the nest's `<alias>__transfer` table: signed balance per address, zero dropped. */
+export function balancesSql(table) {
+  return `SELECT addr, CAST(sum(d) AS VARCHAR) AS bal FROM (SELECT "to" AS addr, value_dec AS d FROM ${table} UNION ALL SELECT "from", -value_dec FROM ${table}) GROUP BY addr HAVING sum(d) <> 0`;
+}
+
+/** `/sql` rows of {addr, bal} into a map of lower-cased address to signed balance. */
+export function balancesFromRows(rows) {
+  return new Map(rows.map(({ addr, bal }) => [String(addr).toLowerCase(), BigInt(bal)]));
+}
+
+/**
+ * The #2048 check. Mints are Transfers from 0x0 and burns are Transfers to it, so the replayed 0x0 balance is
+ * not the chain's: compare the non-zero holders' sum, plus the real `balanceOf(0x0)`, with `totalSupply()`.
+ */
+export function checkReplay(balances, { totalSupply, balanceOfZero }) {
+  const replaySupply = [...balances].filter(([address]) => address !== ZERO_ADDRESS).reduce((sum, [, balance]) => sum + balance, 0n);
+  return { replaySupply, ok: replaySupply + balanceOfZero === totalSupply };
+}
+
+/** Some gateways pad `eth_call` results past 32 bytes; read the first word. */
+export function firstWord(hex) {
+  return BigInt(String(hex).slice(0, 66));
+}
+
+async function jsonRpc(url, method, params) {
+  const response = await fetch(url, {
+    method: "POST",
+    headers: { "content-type": "application/json" },
+    body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }),
+  });
+  const body = await response.json();
+  if (body.error) throw new Error(`${method}: ${body.error.message}`);
+  return body.result;
+}
+
+function prepareNest(options) {
+  mkdirSync(join(options.dir, "abis"), { recursive: true });
+  writeFileSync(join(options.dir, "abis", "erc20_transfer.json"), `${JSON.stringify(TRANSFER_ABI, null, 2)}\n`);
+  const tomlPath = join(options.dir, "nuthatch.toml");
+  if (!existsSync(tomlPath)) writeFileSync(tomlPath, renderNestToml(options));
+  // A nest that already exists keeps its own aliases, which name its tables.
+  for (const match of readFileSync(tomlPath, "utf8").matchAll(/alias = "([^"]+)"\naddress = "(0x[0-9a-f]{40})"/g)) {
+    const token = options.tokens.find(({ address }) => address === match[2]);
+    if (token) token.alias = match[1];
+  }
+}
+
+async function waitForTip(options, base) {
+  for (;;) {
+    await sleep(5000);
+    try {
+      const root = await (await fetch(`${base}/`)).json();
+      const tip = Number.parseInt(await jsonRpc(options.rpc, "eth_blockNumber", []), 16);
+      if (root.last_block && tip - Number(root.last_block) < 100) return;
+    } catch {
+      // still starting
+    }
+  }
+}
+
+export async function runLpNestScan(argv = process.argv.slice(2)) {
+  const options = parseLpNestArgs(argv);
+  prepareNest(options);
+  const base = `http://127.0.0.1:${options.port}`;
+  const startedAt = Date.now();
+  const nest = options.attach
+    ? null
+    : spawn(
+        options.nuthatch,
+        ["dev", "--seal-direct", "--concurrency", String(options.concurrency), "--window", String(options.window), "--no-admin", "--listen", `127.0.0.1:${options.port}`],
+        { cwd: options.dir, stdio: ["ignore", "inherit", "inherit"] },
+      );
+  try {
+    await waitForTip(options, base);
+    const backfillSeconds = Math.round((Date.now() - startedAt) / 1000);
+    const tokens = [];
+    for (const { address, alias } of options.tokens) {
+      const table = `${alias}__transfer`;
+      const sqlResponse = await fetch(`${base}/sql?q=${encodeURIComponent(balancesSql(table))}`);
+      const answer = await sqlResponse.json();
+      if (!Array.isArray(answer.rows) || answer.truncated) throw new Error(`/sql did not return every holder of ${address}: ${JSON.stringify(answer).slice(0, 200)}`);
+      const balances = balancesFromRows(answer.rows);
+      const totalSupply = firstWord(await jsonRpc(options.rpc, "eth_call", [{ to: address, data: TOTAL_SUPPLY_SELECTOR }, "latest"]));
+      const balanceOfZero = firstWord(
+        await jsonRpc(options.rpc, "eth_call", [{ to: address, data: BALANCE_OF_SELECTOR + ZERO_ADDRESS.slice(2).padStart(64, "0") }, "latest"]),
+      );
+      const { replaySupply, ok } = checkReplay(balances, { totalSupply, balanceOfZero });
+      const holders = [...balances]
+        .filter(([holder, balance]) => holder !== ZERO_ADDRESS && totalSupply > 0n && Number((balance * 1_000_000n) / totalSupply) / 10_000 >= options.minPct)
+        .sort((a, b) => (b[1] > a[1] ? 1 : -1))
+        .map(([holder, balance]) => ({ address: holder, balance: balance.toString(), pct: Number((balance * 1_000_000n) / totalSupply) / 10_000 }));
+      tokens.push({
+        lp: address,
+        holders: balances.size - (balances.has(ZERO_ADDRESS) ? 1 : 0),
+        replaySupply: replaySupply.toString(),
+        totalSupply: totalSupply.toString(),
+        balanceOfZero: balanceOfZero.toString(),
+        ok,
+        holdersOverMinPct: holders,
+      });
+    }
+    console.log(JSON.stringify({ backfillSeconds, tokens }, null, 2));
+    if (tokens.some(({ ok }) => !ok)) process.exitCode = 1;
+  } finally {
+    nest?.kill("SIGTERM");
+  }
+}
+
+runDirectCli(import.meta.url, runLpNestScan);
